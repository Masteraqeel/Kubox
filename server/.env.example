# Copy these into your host's environment settings. Never commit real values.
NODE_ENV=production
DATABASE_URL=postgres://user:password@host:5432/kubox
PORT=3000

# Created once, on the first start with an empty database.
ADMIN_USERNAME=Founder
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-password

# Optional: a starting invite code and how many sign-ups it allows.
INVITE_CODE=FIRST-WAVE
INVITE_USES=50
